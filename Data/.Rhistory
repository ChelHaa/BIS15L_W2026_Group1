labs(x = "Time Point", y = "Tube Length (um)", fill = "Microbe Treatment", title="Tube Length of Germinated Pollen Grains with Different Microbial Treatments Over Time")
tube_lengths_dose_dep %>%
group_by(dilution, minutes) %>%
ggplot(aes(x = minutes, y = length, fill = dilution))+
geom_col(position = "dodge")+
theme_bw()+
labs(x = "Time Point", y = "Tube Length (um)", fill = "Microbe Treatment", title="Tube Length of Germinated Pollen Grains with Different Microbial Treatments Over Time")
