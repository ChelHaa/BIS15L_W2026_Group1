theme_minimal() +
labs(title = "Protein Release vs Pollen Type", y = "Mean Protein", x = "Pollen Condition")
})
output$summary_table <- renderTable({
pollen_microbe %>%
group_by(microbe_group, microbe_treatment) %>%
summarise(Avg_Germination = mean(allgerm),
Max_Germination = max(allgerm), .groups = 'drop') %>%
arrange(desc(Avg_Germination))
})
output$protein_scatter_plot <- renderPlot({
# 1. Summarize protein data
protein_summary <- protein_density %>%
group_by(microbe_treatment) %>%
summarise(mean_protein = mean(protein, na.rm = TRUE))
# 2. Summarize germination data
germ_summary <- pollen_microbe %>%
group_by(microbe_treatment) %>%
summarise(mean_germ = mean(allgerm, na.rm = TRUE))
# 3. Join and Plot
inner_join(protein_summary, germ_summary, by = "microbe_treatment") %>%
ggplot(aes(x = mean_protein, y = mean_germ, color = microbe_treatment)) +
geom_point(size = 4) +
geom_smooth(method = "lm", se = FALSE, color = "black", linetype = "dashed") +
theme_minimal() +
scale_color_manual(values = rep(orange_pal, length.out = 10)) +
labs(title = "Protein Release vs. Germination Rate",
x = "Mean Protein Concentration",
y = "Mean Germination Count")
})
shinyApp(ui, server)
