str_detect(timepoint, "h") ~ as.numeric(gsub("h", "", timepoint)) * 60
)) %>%
mutate(timepoint_clean = factor(timepoint_clean, levels = c(15, 45, 90, 180, 240, 360, 720, 1440)))
