library(shiny)
library(tidyverse)
library(janitor)
library(shinythemes)
library(shinydashboard)
# --- Data Preparation (Based on Group 1 Project.Rmd) ---
# 1. Germination Data
pollen_microbe <- read_csv("pollen_microbe_data.csv") %>%
clean_names() %>%
rename(microbe_treatment = microbetreatment) %>%
mutate(across(where(is.numeric), ~replace_na(., 0)))
# 2. Dose Data
dose_dependence <- read_csv("dose_dependence_data.csv") %>%
clean_names() %>%
rename(microbe_treatment = microbetreatment)
# 3. Protein Data
protein_density <- read_csv("Lowry_data1.csv") %>%
clean_names() %>%
rename(pollen_treatment = pollentreatment, microbe_treatment = microbetreatment)
# --- Color Scheme ---
# Based on the Tangerine/Orange palette in your Rmd
orange_pal <- c("#f8e308", "#f9b80a", "#fc750d", "#ff2f11", "#b30c0c")
# --- UI Section ---
ui <- fluidPage(
theme = shinytheme("spacelab"),
# Custom CSS for Light Yellow Background and Black Font
tags$head(
tags$style(HTML("
body { background-color: #FFFFE0; color: black; }
.well { background-color: #FFFACD; border-color: #F0E68C; }
.nav-tabs > li > a { color: black; }
"))
),
titlePanel("Pollen-Microbe Interaction Dashboard"),
sidebarLayout(
sidebarPanel(
h4("Global Filters"),
selectInput("group_select", "1. Choose Microbe Group:",
choices = unique(pollen_microbe$microbe_group),
selected = "Acinetobacter"),
uiOutput("treatment_selector"),
hr(),
h4("Dose Analysis Filters"),
checkboxGroupInput("dose_select", "2. Select SCC477 Dilutions:",
choices = unique(dose_dependence$microbe_treatment),
selected = unique(dose_dependence$microbe_treatment))
),
mainPanel(
tabsetPanel(
# TAB 1: Main Germination Analysis
tabPanel("Germination Explorer",
h3("Microbe Group Results"),
plotOutput("germ_plot"),
hr(),
h3("Dose Dependence (SCC477)"),
plotOutput("dose_plot")),
# TAB 2: Protein & Nutrition (Creative Addition)
tabPanel("Protein Release",
h3("Mean Protein Concentration by Treatment"),
helpText("Showing how microbes induce nutrient release (protein) from pollen."),
plotOutput("protein_plot")),
# TAB 3: Summary Stats (Creative Addition)
tabPanel("Quick Summary",
h3("Top Germination Performance"),
tableOutput("summary_table"))
)
)
)
)
# --- Server Section ---
server <- function(input, output, session) {
# Dynamic UI for treatments
output$treatment_selector <- renderUI({
available_treatments <- pollen_microbe %>%
filter(microbe_group == input$group_select) %>%
pull(microbe_treatment) %>%
unique()
checkboxGroupInput("treat_select", "Select Microbe Treatments:",
choices = available_treatments,
selected = available_treatments[1])
})
# Plot 1: Germination (Orange Theme)
output$germ_plot <- renderPlot({
req(input$treat_select)
pollen_microbe %>%
filter(microbe_group == input$group_select,
microbe_treatment %in% input$treat_select) %>%
ggplot(aes(x = microbe_treatment, y = allgerm, fill = microbe_treatment)) +
geom_col(position = "dodge", color = "black") +
facet_wrap(~timepoint) +
scale_fill_manual(values = rep(orange_pal, length.out = 20)) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1)) +
labs(title = "Total Germination counts", y = "Count", x = "Treatment")
})
# Plot 2: Dose Dependence (Orange Theme)
output$dose_plot <- renderPlot({
req(input$dose_select)
dose_dependence %>%
filter(microbe_treatment %in% input$dose_select) %>%
mutate(timepoint = factor(timepoint, levels = c("15m","45m","90m","3h","4h","6h","12h","24h"))) %>%
ggplot(aes(x = microbe_treatment, y = proportion_germinated, fill = microbe_treatment)) +
geom_boxplot(color = "black") +
facet_wrap(~timepoint, nrow = 2) +
scale_fill_manual(values = rep(orange_pal, length.out = 20)) +
theme_minimal() +
labs(title = "SCC477 Concentration Effects", y = "Proportion", x = "Dilution")
})
# Plot 3: Protein Concentration (Creative)
output$protein_plot <- renderPlot({
protein_density %>%
group_by(pollen_treatment, microbe_treatment) %>%
summarise(mean_protein = mean(protein, na.rm = TRUE), .groups = 'drop') %>%
ggplot(aes(x = pollen_treatment, y = mean_protein, fill = microbe_treatment)) +
geom_col(position = "dodge", color = "black") +
scale_fill_manual(values = rep(orange_pal, length.out = 20)) +
theme_minimal() +
labs(title = "Protein Release vs Pollen Type", y = "Mean Protein", x = "Pollen Condition")
})
# Table: Summary stats
output$summary_table <- renderTable({
pollen_microbe %>%
group_by(microbe_group, microbe_treatment) %>%
summarise(Avg_Germination = mean(allgerm),
Max_Germination = max(allgerm), .groups = 'drop') %>%
arrange(desc(Avg_Germination))
})
}
shinyApp(ui, server)
